@startuml
left to right direction

actor "Funcionário" as Funcionario
actor "Administrador" as Admin
actor "Espectador" as Cliente

rectangle "Sistema de Rede de Cinemas" {

    usecase "Cadastrar Cinema" as UC1
    usecase "Cadastrar Filme" as UC2
    usecase "Controlar Filmes em Cartaz" as UC3
    usecase "Cadastrar Sessão" as UC4
    usecase "Registrar Público da Sessão" as UC5
    usecase "Consultar Relatórios de Público" as UC6
    usecase "Consultar Informações dos Filmes" as UC7
    usecase "Consultar Sessões Disponíveis" as UC8

}

Admin --> UC1
Admin --> UC2
Admin --> UC6

Funcionario --> UC3
Funcionario --> UC4
Funcionario --> UC5

Cliente --> UC7
Cliente --> UC8

@enduml